#!/usr/bin/env python3
"""toastfx-hotkeys: global hotkeys for ToastFX on X11 (no extra packages; talks to libX11 through ctypes).

Reads ~/.config/toastfx/config.json ("hotkeys": {"voice:radio": "Ctrl+Alt+2", "sound:Airhorn": "Ctrl+1", ...})
and runs `toastfx-ctl <voice>`, `toastfx-sfx play <name>` or `toastfx-sfx stop` when a key fires, whether or not
the control window is open and whatever has focus (games included).

Signals:  SIGHUP = reload the config   SIGUSR1 = release all keys (used while the window is learning a new key)
          SIGTERM / SIGINT = quit
"""
import ctypes
import ctypes.util
import json
import os
import select
import signal
import subprocess
import sys
import time

from toastfx_common import *

DEVNULL = subprocess.DEVNULL
SHIFT, LOCK, CONTROL, MOD1, MOD2, MOD4 = 1, 2, 4, 8, 16, 64
KEY_PRESS = 2
GRAB_MODE_ASYNC = 1
MASK = {"Shift": SHIFT, "Ctrl": CONTROL, "Alt": MOD1, "Super": MOD4}
IGNORED = (0, LOCK, MOD2, LOCK | MOD2)           # Caps Lock / Num Lock must not break a hotkey
RELEVANT = SHIFT | CONTROL | MOD1 | MOD4


class XKeyEvent(ctypes.Structure):
    _fields_ = [("type", ctypes.c_int), ("serial", ctypes.c_ulong), ("send_event", ctypes.c_int),
                ("display", ctypes.c_void_p), ("window", ctypes.c_ulong), ("root", ctypes.c_ulong),
                ("subwindow", ctypes.c_ulong), ("time", ctypes.c_ulong), ("x", ctypes.c_int), ("y", ctypes.c_int),
                ("x_root", ctypes.c_int), ("y_root", ctypes.c_int), ("state", ctypes.c_uint),
                ("keycode", ctypes.c_uint), ("same_screen", ctypes.c_int)]


class XEvent(ctypes.Union):
    _fields_ = [("type", ctypes.c_int), ("xkey", XKeyEvent), ("pad", ctypes.c_long * 24)]


ERR_HANDLER = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p)
grab_error = [False]


def _on_x_error(_display, _event):
    grab_error[0] = True                          # BadAccess: another program already owns this combo
    return 0


_keep_alive = ERR_HANDLER(_on_x_error)

x11 = ctypes.CDLL(ctypes.util.find_library("X11") or "libX11.so.6")
x11.XOpenDisplay.restype = ctypes.c_void_p
x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
x11.XDefaultRootWindow.restype = ctypes.c_ulong
x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
x11.XStringToKeysym.restype = ctypes.c_ulong
x11.XStringToKeysym.argtypes = [ctypes.c_char_p]
x11.XKeysymToKeycode.restype = ctypes.c_ubyte
x11.XKeysymToKeycode.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
x11.XGrabKey.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_uint, ctypes.c_ulong, ctypes.c_int,
                         ctypes.c_int, ctypes.c_int]
x11.XUngrabKey.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_uint, ctypes.c_ulong]
x11.XSelectInput.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_long]
x11.XPending.restype = ctypes.c_int
x11.XPending.argtypes = [ctypes.c_void_p]
x11.XNextEvent.argtypes = [ctypes.c_void_p, ctypes.POINTER(XEvent)]
x11.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
x11.XFlush.argtypes = [ctypes.c_void_p]
x11.XConnectionNumber.restype = ctypes.c_int
x11.XConnectionNumber.argtypes = [ctypes.c_void_p]
x11.XSetErrorHandler.restype = ctypes.c_void_p
x11.XSetErrorHandler.argtypes = [ERR_HANDLER]

state = {"reload": True, "pause": False, "quit": False}


def on_signal(sig, _frame):
    if sig == signal.SIGHUP:
        state["reload"], state["pause"] = True, False
    elif sig == signal.SIGUSR1:
        state["reload"], state["pause"] = True, True
    else:
        state["quit"] = True


def action_command(action):
    """Config key -> argv, or None."""
    kind, _, arg = action.partition(":")
    ctl = find_ctl()
    sfx = str(BASE / "toastfx-sfx")
    if kind == "voice" and arg in VOICE_IDS and ctl:
        return [ctl, arg]
    if kind == "sound" and arg:
        return [sys.executable, sfx, "play", arg]
    if kind == "callout" and arg in CALLOUT_IDS:
        return [sys.executable, sfx, "callout", arg]
    if action == "stop:all":
        return [sys.executable, sfx, "stop"]
    return None


def run(argv):
    try:
        subprocess.Popen(argv, stdin=DEVNULL, stdout=DEVNULL, stderr=DEVNULL, start_new_session=True)
    except OSError as exc:
        print("toastfx-hotkeys: could not run", argv[0], exc, file=sys.stderr)


def keycode_for(dpy, key):
    name = key.lower() if len(key) == 1 else key
    sym = x11.XStringToKeysym(name.encode())
    return (x11.XKeysymToKeycode(dpy, sym) if sym else 0)


def write_status(ok, failed):
    try:
        write_json(HK_STATUS, {"ok": ok, "failed": failed, "pid": os.getpid()})
    except OSError:
        pass


def main():
    if listener_pid() not in (None, os.getpid()):
        print("toastfx-hotkeys is already running", file=sys.stderr)
        return 0
    dpy = x11.XOpenDisplay(None)
    if not dpy:
        print("toastfx-hotkeys: cannot open the X display (is DISPLAY set? is this an X11 session?)", file=sys.stderr)
        return 1
    root = x11.XDefaultRootWindow(dpy)
    x11.XSetErrorHandler(_keep_alive)
    fd = x11.XConnectionNumber(dpy)
    HK_PID.parent.mkdir(parents=True, exist_ok=True)
    HK_PID.write_text(str(os.getpid()))
    for s in (signal.SIGHUP, signal.SIGUSR1, signal.SIGTERM, signal.SIGINT):
        signal.signal(s, on_signal)

    grabbed = []          # (keycode, modifiers)
    table = {}            # (keycode, mods) -> action

    def release():
        for kc, mods in grabbed:
            for extra in IGNORED:
                x11.XUngrabKey(dpy, kc, mods | extra, root)
        grabbed.clear()
        table.clear()
        x11.XSync(dpy, 0)

    def grab_all():
        release()
        failed, ok = [], 0
        if not state["pause"]:
            cfg = load_config()
            co = callouts_cfg(cfg)
            for action, combo in cfg["hotkeys"].items():
                if action.startswith("callout:"):       # disabled callouts don't hold a key hostage
                    sid = action.partition(":")[2]
                    if not co["enabled"] or not co["slots"].get(sid, {}).get("enabled", False):
                        continue
                parsed = parse_combo(combo)
                if not parsed or not combo_ok(*parsed) or not action_command(action):
                    continue
                mods_list, key = parsed
                kc = keycode_for(dpy, key)
                if not kc:
                    failed.append(combo)
                    continue
                mods = 0
                for m in mods_list:
                    mods |= MASK[m]
                grab_error[0] = False
                for extra in IGNORED:
                    x11.XGrabKey(dpy, kc, mods | extra, root, 0, GRAB_MODE_ASYNC, GRAB_MODE_ASYNC)
                x11.XSync(dpy, 0)
                if grab_error[0]:
                    for extra in IGNORED:
                        x11.XUngrabKey(dpy, kc, mods | extra, root)
                    x11.XSync(dpy, 0)
                    failed.append(combo)
                    continue
                grabbed.append((kc, mods))
                table[(kc, mods)] = action
                ok += 1
        write_status(ok, failed)

    print("toastfx-hotkeys running", flush=True)
    ev = XEvent()
    last_seen = {}        # callout action -> time of its latest key event (repeat guard)
    try:
        while not state["quit"]:
            if state["reload"]:
                state["reload"] = False
                grab_all()
            select.select([fd], [], [], 0.5)
            while x11.XPending(dpy):
                x11.XNextEvent(dpy, ctypes.byref(ev))
                if ev.type == KEY_PRESS:
                    action = table.get((ev.xkey.keycode, ev.xkey.state & RELEVANT))
                    if action and action.startswith("callout:"):
                        now = time.monotonic()
                        quiet = now - last_seen.get(action, -9.0)
                        last_seen[action] = now          # every repeat refreshes it, so holding the key stays quiet
                        if quiet < CALLOUT_REPEAT_GAP:
                            continue
                    if action:
                        argv = action_command(action)
                        if argv:
                            run(argv)
    finally:
        try:
            release()
            HK_PID.unlink()
            HK_STATUS.unlink()
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
