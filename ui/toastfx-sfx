#!/usr/bin/env python3
"""toastfx-sfx: play soundboard clips into ToastFX's virtual mic through PipeWire.

  toastfx-sfx play NAME|FILE    play a clip (also to your headphones if "hear it myself" is on)
  toastfx-sfx stop              stop every clip that is playing
  toastfx-sfx list              show the library
  toastfx-sfx add FILE [NAME]   add a clip to the library
  toastfx-sfx test              play two test tones, one after the other overlapping

Squad callouts (four cues; each has its own on/off, volume and optional key; see docs/CALLOUTS.md):
  toastfx-sfx callout SLOT [--quiet]   play one: comms_check | ack | incoming | disconnect (--quiet: no desktop note)
  toastfx-sfx callouts          show status of the master switch and the four slots
  toastfx-sfx callout-replace SLOT FILE.wav   use your own WAV for a slot (converted to 48 kHz stereo)
  toastfx-sfx callout-reset SLOT              go back to the shipped sound
  toastfx-sfx callouts-on | callouts-off      master switch for the whole callout soundboard
"""
EXIT_OFF, EXIT_MISSING = 2, 3
import hashlib
import math
import os
import shutil
import struct
import subprocess
import sys
import time
import wave
from pathlib import Path

from toastfx_common import *

NATIVE = {".wav", ".flac", ".ogg", ".oga"}
DEVNULL = subprocess.DEVNULL


def die(msg):
    print("toastfx-sfx:", msg, file=sys.stderr)
    sys.exit(1)


def playable(path):
    """Return a file pw-play can read, converting with ffmpeg (cached) when needed."""
    p = Path(path).expanduser()
    if not p.is_file():
        die(f"file not found: {p}")
    if p.suffix.lower() in NATIVE:
        return p
    CACHE.mkdir(parents=True, exist_ok=True)
    key = hashlib.sha1(f"{p.resolve()}:{p.stat().st_mtime_ns}".encode()).hexdigest()[:16]
    out = CACHE / f"{key}.wav"
    if not out.exists():
        try:
            r = subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", str(p), "-ar", "48000", "-ac", "2",
                                "-c:a", "pcm_s16le", str(out)], capture_output=True)
        except FileNotFoundError:
            die("ffmpeg is needed to play this file type (sudo apt install ffmpeg)")
        if r.returncode:
            out.unlink(missing_ok=True)
            die("ffmpeg could not read that file: " + r.stderr.decode(errors="replace")[:200])
    return out


def spawn(file, name, target, volume):
    cmd = ["pw-play"]
    if target:
        cmd += ["--target", target]
    cmd += ["--volume", f"{volume:.2f}", str(file)]
    try:
        proc = subprocess.Popen(cmd, stdin=DEVNULL, stdout=DEVNULL, stderr=DEVNULL, start_new_session=True)
    except FileNotFoundError:
        die("pw-play not found (it comes with the pipewire-bin package)")
    PLAYING.mkdir(parents=True, exist_ok=True)
    (PLAYING / str(proc.pid)).write_text(name)
    return proc


def lookup(arg):
    for s in load_library():
        if s["name"].lower() == arg.lower():
            return s["name"], s["path"]
    if Path(arg).expanduser().is_file():
        return Path(arg).stem, arg
    die(f"no sound called '{arg}' (try: toastfx-sfx list)")


def cmd_play(arg):
    name, path = lookup(arg)
    cfg = load_config()
    f = playable(path)
    vol = max(0.0, min(1.0, float(cfg.get("volume", 0.7))))
    spawn(f, name, SINK, vol)
    if cfg.get("monitor", False):
        spawn(f, name, None, vol)


def cmd_stop():
    import os
    import signal
    for pid in players():
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        try:
            (PLAYING / str(pid)).unlink()
        except OSError:
            pass


# ---- squad callouts -------------------------------------------------------------
def notify(text):
    """Small on-screen note (works while you're in a game); silently skipped if notify-send isn't installed."""
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "ToastFX", "-t", "1200", "-h",
                        "string:x-canonical-private-synchronous:toastfx-callout", "ToastFX", text],
                       stdin=DEVNULL, stdout=DEVNULL, stderr=DEVNULL)


def debounced(slot):
    """True if this slot fired within CALLOUT_DEBOUNCE seconds: swallows key-repeat and double presses."""
    RUN.mkdir(parents=True, exist_ok=True)
    mark = RUN / f"toastfx-callout-{slot}.last"
    now = time.time()
    try:
        if now - float(mark.read_text()) < CALLOUT_DEBOUNCE:
            return True
    except (OSError, ValueError):
        pass
    try:
        mark.write_text(repr(now))
    except OSError:
        pass
    return False


def valid_wav(path):
    try:
        with wave.open(str(path), "rb") as w:
            return w.getnframes() > 0 and w.getframerate() > 0
    except (wave.Error, EOFError, OSError):
        return False


def cmd_callout(slot, quiet=False):
    if slot not in CALLOUT_IDS:
        die(f"unknown callout '{slot}' (use: {', '.join(CALLOUT_IDS)})")
    label = CALLOUT_LABELS[slot]
    cfg = load_config()
    co = callouts_cfg(cfg)
    if not co["enabled"]:
        if not quiet:
            notify("Callout soundboard is off")
        print("toastfx-sfx: callout soundboard is off", file=sys.stderr)
        return EXIT_OFF
    sl = co["slots"][slot]
    if not sl["enabled"]:
        if not quiet:
            notify(f"{label} is off")
        print(f"toastfx-sfx: {label} is off", file=sys.stderr)
        return EXIT_OFF
    if debounced(slot):
        return 0
    f = callout_file(slot)
    if f is None or not valid_wav(f):
        if not quiet:
            notify(f"{label}: sound unavailable")
        print(f"toastfx-sfx: {label}: sound file missing or unreadable", file=sys.stderr)
        return EXIT_MISSING
    vol = max(0.0, min(1.0, co["volume"] * sl["volume"]))
    spawn(f, f"callout:{slot}", SINK, vol)              # PipeWire mixes it into the virtual mic with your voice
    if cfg.get("monitor", False):                        # only to your headphones if you chose "hear it myself"
        spawn(f, f"callout:{slot}", None, vol)
    if not quiet:
        notify(label)
    return 0


def cmd_callouts_status():
    cfg = load_config()
    co = callouts_cfg(cfg)
    print("Callout soundboard:", "ON" if co["enabled"] else "OFF", f"(master volume {co['volume']:.2f})")
    for sid in CALLOUT_IDS:
        sl = co["slots"][sid]
        f = callout_file(sid)
        key = cfg["hotkeys"].get("callout:" + sid, "-")
        print(f"  {sid:<12} {'on ' if sl['enabled'] else 'off'} vol {sl['volume']:.2f}  key {key:<14} "
              f"{'custom' if callout_is_custom(sid) else 'shipped'}  {f if f else 'MISSING'}")


def cmd_callouts_switch(on):
    cfg = load_config()
    callouts_cfg(cfg)["enabled"] = on
    save_config(cfg)
    print("callout soundboard", "on" if on else "off")


def cmd_replace(slot, src):
    if slot not in CALLOUT_IDS:
        die(f"unknown callout '{slot}'")
    err = import_wav(src, CALLOUT_DIR / f"{slot}.wav")
    if err:
        die(f"could not use that file: {err}")
    print(f"{CALLOUT_LABELS[slot]} now uses {src}")


def tone(path, freq, secs=2.0):
    r = 48000
    n = int(r * secs)
    with wave.open(str(path), "wb") as w:
        w.setnchannels(2)
        w.setsampwidth(2)
        w.setframerate(r)
        frames = bytearray()
        for i in range(n):
            fade = min(1.0, i / 2400, (n - i) / 2400)
            v = int(32767 * 0.3 * fade * math.sin(2 * math.pi * freq * i / r))
            frames += struct.pack("<hh", v, v)
        w.writeframes(bytes(frames))


def cmd_test():
    CACHE.mkdir(parents=True, exist_ok=True)
    a, b = CACHE / "test-a.wav", CACHE / "test-b.wav"
    tone(a, 440)
    tone(b, 660)
    vol = float(load_config().get("volume", 0.7))
    print("playing a low tone, then a higher tone on top of it...")
    spawn(a, "test tone A", SINK, vol)
    time.sleep(0.6)
    spawn(b, "test tone B", SINK, vol)


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd = argv[1]
    if cmd == "play" and len(argv) >= 3:
        cmd_play(" ".join(argv[2:]))
    elif cmd == "stop":
        cmd_stop()
    elif cmd == "list":
        for s in load_library():
            hk = load_config()["hotkeys"].get("sound:" + s["name"], "")
            print(f"{s['name']:<24} {hk:<14} {s['path']}")
    elif cmd == "add" and len(argv) >= 3:
        lib = load_library()
        name = argv[3] if len(argv) > 3 else Path(argv[2]).stem
        lib.append({"name": name, "path": str(Path(argv[2]).expanduser().resolve())})
        save_library(lib)
        print("added", name)
    elif cmd == "test":
        cmd_test()
    elif cmd == "callout" and len(argv) >= 3:
        return cmd_callout(argv[2], quiet="--quiet" in argv[3:])
    elif cmd == "callouts":
        cmd_callouts_status()
    elif cmd in ("callouts-on", "callouts-off"):
        cmd_callouts_switch(cmd == "callouts-on")
    elif cmd == "callout-replace" and len(argv) >= 4:
        cmd_replace(argv[2], argv[3])
    elif cmd == "callout-reset" and len(argv) >= 3:
        callout_reset(argv[2])
        print("reset", argv[2])
    else:
        print(__doc__)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
